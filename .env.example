# 외부 주소 (Tailscale Funnel). Docker 실행 시 필수, 로컬 npm run dev는 생략 → http://localhost:3000
# PUBLIC_URL=https://tistory-mcp.<tailnet>.ts.net
# 첫 실행용 Tailscale 인증 키 (관리 콘솔 → Settings → Keys)
TS_AUTHKEY=
PORT=3000
# /authorize 화면 패스프레이즈. 16자 이상
OWNER_PASSPHRASE=
# https://{이 값}.tistory.com
TISTORY_BLOG_NAME=
# 브라우저 Cookie 헤더 값 전체를 담은 파일 (Docker에선 볼륨 마운트)
TISTORY_COOKIE_FILE=./secrets/tistory_cookie.txt
