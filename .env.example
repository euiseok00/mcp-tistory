# 외부 주소 (quick tunnel URL). 로컬 테스트는 생략 → http://localhost:3000
# PUBLIC_URL=https://xxxx.trycloudflare.com
PORT=3000
# /authorize 화면 패스프레이즈. 16자 이상
OWNER_PASSPHRASE=
# https://{이 값}.tistory.com
TISTORY_BLOG_NAME=
# 브라우저 Cookie 헤더 값 전체를 담은 파일 (Docker에선 볼륨 마운트)
TISTORY_COOKIE_FILE=./secrets/tistory_cookie.txt
