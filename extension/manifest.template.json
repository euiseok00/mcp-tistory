{
  "manifest_version": 3,
  "name": "MCP-Tistory",
  "version": "0.1.0",
  "description": "Claude가 만든 글을 확인 후 티스토리에 임시저장합니다. 쿠키를 읽거나 전송하지 않습니다.",
  "host_permissions": [
    "https://*.tistory.com/*",
    "__SERVER_ORIGIN__/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["__SERVER_ORIGIN__/d/*", "http://localhost:3000/d/*"],
      "js": ["content.js"]
    }
  ]
}
